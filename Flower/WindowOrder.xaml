<Window x:Class="Flower.WindowOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flower"
        mc:Ignorable="d"
        Title="Оформление заказа" Height="500" Width="400">
    <Grid>
        <Label Content="Оформление заказа" HorizontalAlignment="Left" Margin="10,16,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
        <TextBox x:Name="LastNameTextBox" HorizontalAlignment="Center" Margin="0,84,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="362" Height="27"/>
        <Label Content="Введите фамилию:" HorizontalAlignment="Left" Margin="19,58,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Center" Margin="0,137,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="362" Height="27"/>
        <Label Content="Введите имя:" HorizontalAlignment="Left" Margin="19,111,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="SurnameTextBox" HorizontalAlignment="Center" Margin="0,190,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="362" Height="27"/>
        <Label Content="Введите отчество:" HorizontalAlignment="Left" Margin="19,164,0,0" VerticalAlignment="Top"/>
        <Label Content="Введите Номер:" HorizontalAlignment="Left" Margin="19,217,0,0" VerticalAlignment="Top"/>
        <xctk:MaskedTextBox x:Name="PhoneMaskedBox" Mask="+7 000 000-00-00" PromptChar="_" Margin="0,243,0,0" HorizontalAlignment="Center" Width="362" Height="30" VerticalAlignment="Top"/>
        <Border BorderBrush="#FFABADB3" BorderThickness="1" HorizontalAlignment="Center" Margin="0,296,0,0" VerticalAlignment="Top" Width="362" Height="27" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text=" ул. " VerticalAlignment="Center"/>
                <TextBox x:Name="StreetTextBox" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text=", д. " VerticalAlignment="Center"/>
                <TextBox x:Name="HouseTextBox" Grid.Column="3" BorderThickness="0" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="AptLabel" Grid.Column="4" Text=", кв. " VerticalAlignment="Center"/>
                <xctk:MaskedTextBox x:Name="ApartmentMaskedBox" Grid.Column="5" Mask="0000" PromptChar=" " BorderThickness="0" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <CheckBox x:Name="NoApartmentCheckBox" Content="Нет квартиры (частный дом)" HorizontalAlignment="Left" Margin="19,330,0,0" VerticalAlignment="Top" Checked="NoApartmentCheckBox_Checked" />

        <DatePicker x:Name="DeliveryDatePicker" HorizontalAlignment="Left" Margin="19,379,0,0" VerticalAlignment="Top" Width="245" Height="27"/>
        <xctk:MaskedTextBox x:Name="DeliveryTimeMaskedBox" Mask="00:00" PromptChar="_" HorizontalAlignment="Left" Margin="274,379,0,0" VerticalAlignment="Top" Width="107" Height="27" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <Button x:Name="CreateOrderButton" Content="Оформить заказ" HorizontalAlignment="Center" Margin="0,433,0,0" VerticalAlignment="Top" Width="362" Height="32" Loaded="CreateOrderButton_Loaded" Click="CreateOrderButton_Click" Background="White"/>
        <Label Content="Введите адрес:" HorizontalAlignment="Left" Margin="19,273,0,0" VerticalAlignment="Top"/>
        <Label Content="Введите время" HorizontalAlignment="Left" Margin="274,353,0,0" VerticalAlignment="Top"/>
        <Label Content="Введите дату" HorizontalAlignment="Left" Margin="19,353,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
