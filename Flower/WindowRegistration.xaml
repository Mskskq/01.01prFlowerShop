<Window x:Class="Flower.WindowRegistration"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flower"
        mc:Ignorable="d"
        Title="Регистрация" Height="450" Width="400">
    <Grid Margin="25,15" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="LastnameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="SurnameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Логин:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="LoginTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Пароль:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="PasswordTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Телефон:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <xctk:MaskedTextBox x:Name="PhoneMaskedBox" Grid.Row="5" Grid.Column="1" Mask="+7 000 000-00-00" PromptChar="_" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Адрес:" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Улица" FontSize="11"/>
            <TextBox x:Name="StreetTextBox" Grid.Row="1" Grid.Column="0" Margin="0,2,5,0" TextChanged="StreetTextBox_TextChanged"/>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Дом" FontSize="11"/>
            <TextBox x:Name="HouseTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2,5,0" TextChanged="HouseTextBox_TextChanged"/>

            <TextBlock x:Name="AptLabel" Grid.Row="0" Grid.Column="2" Text="Квартира" FontSize="11"/>
            <TextBox x:Name="ApartmentTextBox" Grid.Row="1" Grid.Column="2" Margin="0,2,0,0" TextChanged="ApartmentTextBox_TextChanged"/>
        </Grid>

        <CheckBox x:Name="NoApartmentCheckBox" Grid.Row="7" Grid.Column="1" Content="Нет квартиры (частный дом)" Margin="0,0,0,15" Checked="NoApartmentCheckBox_Checked"/>

        <Button x:Name="RegisterSubmitButton" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Content="Зарегистрироваться" Height="30" Click="RegisterSubmitButton_Click"/>
        <Label Content="Регистрация" HorizontalAlignment="Left" Margin="7,-61,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="24" Grid.Column="1"/>
        
        
    
    </Grid>
</Window>
