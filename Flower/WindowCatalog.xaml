<Window x:Class="Flower.WindowCatalog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flower"
        mc:Ignorable="d"
        Title="WindowCatalog" Height="450" Width="800">
    <Grid>
        <ListView x:Name="FlowerListView" Margin="10,65,318,10" MouseDoubleClick="FlowerListView_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source="{Binding Img}" Width="80" Height="80" Stretch="UniformToFill"/>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Label Content="Каталог:" HorizontalAlignment="Left" Margin="20,31,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        <Label x:Name="UserLoginLabel" Content="Label" HorizontalAlignment="Left" Margin="638,10,0,0" VerticalAlignment="Top" Loaded="UserLoginLabel_Loaded"/>
        <DataGrid x:Name="CorsinaDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="487,65,10,151">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название цветов" Binding="{Binding Flowers.Name}" Width="150"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Flowers.Price, StringFormat={}{0} руб.}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="CreateOrderButton" Content="Оформить заказ" HorizontalAlignment="Left" Margin="486,322,0,0" VerticalAlignment="Top" Background="White" Height="35" Width="304" Click="CreateOrderButton_Click"/>
        <Button x:Name="DeleteFlowerInCorsinaButton" Content="Удалить поизицию" HorizontalAlignment="Left" Margin="487,371,0,0" VerticalAlignment="Top" Background="White" Height="35" Width="303" Click="DeleteFlowerInCorsinaButton_Click"/>
        <Label Content="Итого: " HorizontalAlignment="Left" Margin="487,288,0,0" VerticalAlignment="Top" Width="48"/>
        <Label x:Name="TotalPriceLabel" Content="0" HorizontalAlignment="Left" Margin="540,288,0,0" VerticalAlignment="Top" Width="88" FontWeight="Bold" FontSize="14" Foreground="#FF0F902E"/>
        <Label Content="Корзина: " HorizontalAlignment="Left" Margin="486,31,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
    </Grid>
</Window>
