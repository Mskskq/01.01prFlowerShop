<Window x:Class="Flower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flower"
        mc:Ignorable="d"
        Title="Авторизация" Height="300" Width="350">
    <Grid>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="330" Margin="0,103,0,0" Height="160">
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginTextBox" Margin="0,5,0,10"/>

            <TextBlock Text="Пароль"/>
            <TextBox x:Name="PasswordTextBox" Margin="0,5,0,10"/>

            <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click" Margin="0,0,0,10"/>
            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Click="RegisterButton_Click"/>

        </StackPanel>
        <Label Content="Авторизация" HorizontalAlignment="Center" Margin="0,41,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="24"/>
    </Grid>
</Window>
